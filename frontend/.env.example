# Public browser → same-origin Next.js BFF proxy (/api/v1/*)
NEXT_PUBLIC_API_URL=/api/v1

# Browser WebSocket → Render Django/Channels (Vercel cannot proxy WS)
# Production example: wss://unicare-backend.onrender.com
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Must match backend HOSPITAL_ACCESS_SECRET (injected by the BFF for hospital routes)
NEXT_PUBLIC_HOSPITAL_ACCESS_TOKEN=change-hospital-access-secret

# Server-only: Next.js route handler proxies /api/v1/* to the Render backend
# Production example: https://unicare-backend.onrender.com
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional UI copy
NEXT_PUBLIC_EMERGENCY_NUMBER=+2348000000000
NEXT_PUBLIC_HEALTH_CENTER_PHONE=+2348000000000
NEXT_PUBLIC_HEALTH_CENTER_EMAIL=healthcenter@example.edu
NEXT_PUBLIC_HEALTH_CENTER_LOCATION=University Health Centre
